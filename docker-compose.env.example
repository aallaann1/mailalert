# ==========================================
# Configuration Générale MailAlert (Production)
# ==========================================
PORT=8000
BACKEND_URL=https://mailalert.yourdomain.com
FRONTEND_URL=https://mailalert.yourdomain.com

# Clé secrète FastAPI (générez une chaîne aléatoire)
SECRET_KEY=generate_a_random_secure_secret_key_here

# Identifiants Google Cloud Console (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PROJECT_ID=your_google_cloud_project_id
PUBSUB_TOPIC_NAME=projects/your_google_cloud_project_id/topics/gmail-notifications

# Configuration Base de Données PostgreSQL
POSTGRES_PASSWORD=choose_a_strong_password_here

# (Optionnel) Identifiants GHCR si votre image de conteneur est privée
GITHUB_REPOSITORY=aallaann1/mailalert
# GHCR_USER=your_github_username
# GHCR_TOKEN=your_github_personal_access_token_with_read_packages
